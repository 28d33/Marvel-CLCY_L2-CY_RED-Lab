; ipvlab.lab - lab zone served by m1 (10.10.10.2)
; Exercises in passive recon: dig/nslookup, CNAME, TXT, and AXFR.
$TTL 600
@   IN SOA  ns1.ipvlab.lab. ops.ipvlab.lab. (
                2025010101 ; serial
                3600       ; refresh
                900        ; retry
                604800     ; expire
                60 )       ; negative TTL

@   IN NS   ns1.ipvlab.lab.
@   IN A    10.10.10.2

ns1    IN A    10.10.10.2
m1     IN A    10.10.10.2

; hostnames a subdomain sweep would find (all the perimeter host for now)
www     IN CNAME m1.ipvlab.lab.
web     IN CNAME m1.ipvlab.lab.
api     IN CNAME m1.ipvlab.lab.
dev     IN A    10.10.10.2
staging IN A    10.10.10.2
test    IN A    10.10.10.2
qa      IN A    10.10.10.2
blog    IN A    10.10.10.2
mail    IN A    10.10.10.2
vpn     IN A    10.10.10.2
admin   IN A    10.10.10.2
backup  IN A    10.10.10.2
files   IN A    10.10.10.2
intranet IN A   10.10.10.2
old     IN A    10.10.10.2
gw      IN A    10.10.10.2

; TXT records: "passive" intel nuggets (worth a dig TXT m1.ipvlab.lab)
_dmarc.ipvlab.lab. IN TXT "v=DMARC1; p=none;"
ipvlab.lab.        IN TXT "Security lab target - start at m1, pivot deeper"
ops.ipvlab.lab.    IN TXT "mail ops@ipvlab.lab for the app's backup password"
